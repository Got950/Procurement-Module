# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharma_procurement?schema=public"
# Max pool connections per process (web and worker each open a pool).
# Staging (2 vCPU / ~4 GiB): keep at 8 so 2×8 stays well under Postgres defaults.
# DATABASE_POOL_MAX="8"

# Staging concurrency / rate-limit knobs (optional; sensible defaults in code):
# LOGIN_RATE_LIMIT_PER_IP="150"     # per 15 minutes (shared-NAT friendly)
# LOGIN_RATE_LIMIT_PER_ID="12"      # per account / 15 minutes
# MUTATE_RATE_LIMIT_PER_MIN="240"   # POST/PUT/PATCH/DELETE per IP
# COPILOT_MAX_CONCURRENT="3"        # in-flight Copilot turns (process-wide)
# PDF_MAX_CONCURRENT="2"            # in-flight PDF generations (process-wide)
# Integration tests run here; defaults to DATABASE_URL with _test appended.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharma_procurement_test"

# Session JWT signing key. Required in every environment, minimum 32 chars.
SESSION_SECRET="replace-with-long-random-string-at-least-32-chars"

# Required by `npm run db:seed-admin`; there is no default admin password.
ADMIN_INITIAL_PASSWORD=""
# Optional override for `npm run db:seed-demo-users` (defaults to ADMIN_INITIAL_PASSWORD).
# DEMO_USER_PASSWORD=""
# Optional overrides for the seeded admin identity.
# ADMIN_EMAIL="admin@must.co.in"
# ADMIN_USERNAME="admin"

# OpenAI (server-side only; never use NEXT_PUBLIC_ for the key)
OPENAI_API_KEY="replace-with-your-openai-api-key"
# Optional; default gpt-4o-mini
# OPENAI_MODEL="gpt-4o-mini"
# Optional Copilot chat model; defaults to OPENAI_MODEL / gpt-4o-mini
# OPENAI_COPILOT_MODEL="gpt-4o-mini"

# Gmail OAuth — use YOUR Google Cloud project (not a teammate's unless you are added as a Test user).
# 1) https://console.cloud.google.com → APIs & Services → Enable Gmail API
# 2) OAuth consent screen → External → Testing → add your Gmail under Test users
# 3) Credentials → OAuth client (Web) → Authorized redirect URIs (add every URL you use):
#    http://localhost:3000/api/integrations/gmail/callback
#    https://medflow-13-50-17-61.sslip.io/api/integrations/gmail/callback   # staging HTTPS (when reconnecting)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://localhost:3000/api/integrations/gmail/callback"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Staging HTTPS example (do not commit real secrets):
# APP_URL="https://medflow-13-50-17-61.sslip.io"
# NEXT_PUBLIC_APP_URL="https://medflow-13-50-17-61.sslip.io"
# FORCE_SECURE_COOKIES="1"

# Encrypt stored Gmail refresh token (use 64 hex chars / 32 bytes in real deploys)
GMAIL_TOKEN_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"
# Optional per-deployment KDF salt (defaults to legacy "gmail-salt"). Changing this
# invalidates stored Gmail refresh tokens — reconnect OAuth after rotating.
# GMAIL_TOKEN_SALT="replace-with-unique-deployment-salt"

# Cookie Secure flag. Defaults to NODE_ENV=production. Set 1 behind HTTPS (ALB).
# FORCE_SECURE_COOKIES="1"
# Canonical origin for CSRF checks (B-63)
# APP_URL="https://procurement.example.com"

# Document store: unset = local disk. Set to an S3 bucket for ECS multi-task.
# S3_BUCKET=""
# AWS_REGION="us-east-1"
# Optional: also mirror uploads under data/uploads when using S3 (single-host lab only).
# DOCUMENT_LOCAL_CACHE="1"

# Process RFQ email jobs in-process (local dev). Unset in ECS and run worker (`ROLE=worker`).
JOBS_INLINE="1"

# Optional: emit CloudWatch EMF metric lines
# EMIT_EMF="1"


# Purchase orders: procurement uploads a PDF on the indent (no env required here).
# Optional footer line if you add PO email templates later:
# PO_CONTACT_LINE="Questions: Name, +1…, email@…"

